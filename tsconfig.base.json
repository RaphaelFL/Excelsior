{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@excelsior/charts": ["packages/charts/src/index.ts"],
      "@excelsior/core": ["packages/core/src/index.ts"],
      "@excelsior/devtools": ["packages/devtools/src/index.ts"],
      "@excelsior/formulas": ["packages/formulas/src/index.ts"],
      "@excelsior/renderer-dom": ["packages/renderer-dom/src/index.ts"],
      "@excelsior/xlsx": ["packages/xlsx/src/index.ts"],
      "@excelsior/vanilla": ["packages/vanilla/src/index.ts"]
    }
  }
}