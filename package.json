{
  "name": "excelsior",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present --include-workspace-root=false",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "audit": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "release:check": "npm run typecheck && npm run test && npm run build && npm run audit:prod",
    "dev": "npm run dev -w @excelsior/playground",
    "bench": "npm run dev -w @excelsior/benchmark"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.3.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.18"
  }
}