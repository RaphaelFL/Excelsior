{
  "name": "excelsior",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present --include-workspace-root=false",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "audit": "npm audit",
    "audit:runtime": "node scripts/audit-runtime-dependencies.mjs",
    "audit:prod": "npm audit --omit=dev",
    "release:check": "npm run audit:runtime && npm run typecheck && npm run test && npm run build && npm run audit:prod"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.3.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
