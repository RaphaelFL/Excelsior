{
  "name": "@excelsior/xlsx",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts && tsup src/index.cts --format cjs"
  },
  "dependencies": {
    "@excelsior/core": "0.1.0",
    "read-excel-file": "^9.0.10",
    "write-excel-file": "^4.0.7"
  }
}